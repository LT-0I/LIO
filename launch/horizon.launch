<launch>

    <node pkg="lio_livox" type="ScanRegistration" name="ScanRegistration" output="screen" >

        <param name="config_file" value="$(find lio_livox)/config/horizon_config.yaml"/>
    </node>

    <node pkg="lio_livox" type="PoseEstimation" name="PoseEstimation" output="screen"> 
        <!-- 0-Not Use IMU, 1-Use IMU remove Rotation Distort, 2-Tightly Coupled IMU -->
        <param name="IMU_Mode" type="int" value="2" />
        
        <!-- ========== 体素滤波参数（值越大点越少，越快但可能精度下降）========== -->
        <param name="filter_parameter_corner" type="double" value="0.2" />
        <param name="filter_parameter_surf" type="double" value="0.35" />
        <param name="filter_parameter_nonfeature" type="double" value="1" />
        <!-- 隧道场景 ROI (cube 半径) 可配置，默认21 11 21-->
        <param name="roi_depth" type="int" value="8" />
        <param name="roi_width" type="int" value="3" />
        <param name="roi_height" type="int" value="2" />
        <!-- 发布全量重投影点云（Rviz可视化），默认启用，步长5减轻计算 -->
        <param name="enable_full_cloud_publish" type="bool" value="true" />
        <param name="publish_downsample_stride" type="int" value="5" />
        
        <!-- ========== 优化参数（调小可加速，但可能影响精度）========== -->
        <!-- 外层迭代次数（默认4，稳定后；初始化阶段自动-1）-->
        <param name="max_iterations" type="int" value="4" />
        <!-- Ceres 内部迭代次数（默认10）-->
        <param name="ceres_max_iterations" type="int" value="8" />
        <!-- 收敛阈值：角度（度）和位移（米），小于此值提前终止 -->
        <param name="convergence_threshold_r" type="double" value="0.05" />
        <param name="convergence_threshold_t" type="double" value="0.05" />
        
        <!-- Extrinsic Parameter between Lidar & IMU -->
        <rosparam param="Extrinsic_Tlb"> [1.0, 0.0, 0.0, -0.05512,
                                          0.0, 1.0, 0.0, -0.02226,
                                          0.0, 0.0, 1.0,  0.0297,
                                          0.0, 0.0, 0.0,  1.0]</rosparam>
    </node>

    <!--node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find lio_livox)/rviz_cfg/lio.rviz" /-->
    <!-- serial_bridge 现在作为独立进程由 ProcessManager 管理，不再随 SLAM 启动 -->
    <!-- <include file ="$(find serial_bridge)/launch/opi_sender.launch"/> -->
</launch>
